# Copia questo file in .env e inserisci i tuoi valori reali:
#   cp .env.example .env
# Il file .env e' escluso da git: le credenziali non finiscono mai su GitHub.

# Server SMTP di Gmail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# Il tuo indirizzo Gmail completo
MAIL_USERNAME=tuonome@gmail.com

# App Password di 16 caratteri generata da Google (NON la password dell'account).
# Si crea su https://myaccount.google.com/apppasswords
# con la verifica in 2 passaggi attiva. Va scritta senza spazi.
MAIL_PASSWORD=xxxxxxxxxxxxxxxx

# Mittente mostrato al destinatario (opzionale, default: MAIL_USERNAME)
MAIL_FROM=tuonome@gmail.com

# Database PostgreSQL locale: adatta se il tuo Postgres ha porta/nome db diversi
DB_URL=jdbc:postgresql://localhost:5432/demo
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Chiave segreta per firmare i JWT: generane una tua, es. con
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_EXPIRATION_MINUTES=60
